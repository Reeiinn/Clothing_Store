generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum Gender {
  MEN
  WOMEN
  UNISEX
}

// Declared in display order so ORDER BY size sorts XS..XL
enum Size {
  XS
  S
  M
  L
  XL
}

enum OrderStatus {
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ShippingMethod {
  STANDARD
  EXPRESS
}

enum PaymentMethod {
  CARD
  EWALLET
  COD
}

enum ReturnReason {
  SIZE_DIDNT_FIT
  NOT_AS_PICTURED
  DAMAGED
  WRONG_ITEM
  CHANGED_MIND
  OTHER
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  RECEIVED
  REJECTED
}

model User {
  id        String    @id @default(cuid())
  name      String?
  email     String?   @unique
  password  String?
  role      Role      @default(CUSTOMER)
  bagItems  BagItem[]
  orders    Order[]
  addresses Address[]
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

model Color {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  hex      String
  variants Variant[]
}

model Product {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String
  fabric      String?
  fitNotes    String?
  gender      Gender
  priceCents  Int // centavos
  imageUrl    String?
  hidden      Boolean       @default(false)
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  variants    Variant[]
  image       ProductImage?
  createdAt   DateTime      @default(now())

  @@index([categoryId, gender])
}

model ProductImage {
  productId   String  @id
  data        Bytes
  contentType String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Variant {
  id         String      @id @default(cuid())
  sku        String      @unique
  productId  String
  colorId    String
  size       Size
  stock      Int         @default(0)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  color      Color       @relation(fields: [colorId], references: [id])
  bagItems   BagItem[]
  orderItems OrderItem[]

  @@unique([productId, colorId, size])
  @@index([size, stock])
}

model BagItem {
  id            String   @id @default(cuid())
  userId        String
  variantId     String
  quantity      Int
  savedForLater Boolean  @default(false)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant       Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  fullName   String
  phone      String
  street     String
  unit       String?
  city       String
  province   String
  postalCode String
  isDefault  Boolean @default(false)
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Order {
  id             String               @id @default(cuid())
  number         Int                  @unique @default(autoincrement())
  userId         String
  status         OrderStatus          @default(PROCESSING)
  subtotalCents  Int
  shippingCents  Int
  shippingMethod ShippingMethod
  paymentMethod  PaymentMethod
  cardLast4      String?
  trackingNumber String?
  // Snapshot of the shipping address at checkout
  shipFullName   String
  shipPhone      String
  shipStreet     String
  shipUnit       String?
  shipCity       String
  shipProvince   String
  shipPostalCode String
  createdAt      DateTime             @default(now())
  shippedAt      DateTime?
  deliveredAt    DateTime?
  user           User                 @relation(fields: [userId], references: [id])
  items          OrderItem[]
  history        OrderStatusHistory[]
  returns        ReturnRequest[]

  @@index([userId, status])
}

model OrderItem {
  id             String       @id @default(cuid())
  orderId        String
  variantId      String
  // Snapshot of the product at checkout
  productName    String
  colorName      String
  size           Size
  unitPriceCents Int
  quantity       Int
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant        Variant      @relation(fields: [variantId], references: [id])
  returnItems    ReturnItem[]
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model ReturnRequest {
  id        String       @id @default(cuid())
  orderId   String
  status    ReturnStatus @default(REQUESTED)
  note      String?
  createdAt DateTime     @default(now())
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items     ReturnItem[]
}

model ReturnItem {
  id              String        @id @default(cuid())
  returnRequestId String
  orderItemId     String
  quantity        Int
  reason          ReturnReason
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id])
}

model StoreSetting {
  id                Int @id @default(1)
  lowStockThreshold Int @default(3)
}
