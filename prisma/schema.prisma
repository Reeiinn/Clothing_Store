generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN

  @@map("role")
}

enum Gender {
  MEN
  WOMEN
  UNISEX

  @@map("gender")
}

// Declared in display order so ORDER BY size sorts XS..XL
enum Size {
  XS
  S
  M
  L
  XL

  @@map("size")
}

enum OrderStatus {
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED

  @@map("order_status")
}

enum ShippingMethod {
  STANDARD
  EXPRESS

  @@map("shipping_method")
}

enum PaymentMethod {
  CARD
  EWALLET
  COD

  @@map("payment_method")
}

enum ReturnReason {
  SIZE_DIDNT_FIT
  NOT_AS_PICTURED
  DAMAGED
  WRONG_ITEM
  CHANGED_MIND
  OTHER

  @@map("return_reason")
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  RECEIVED
  REJECTED

  @@map("return_status")
}

model User {
  id        String    @id @default(cuid())
  name      String?
  email     String?   @unique
  password  String?
  role      Role      @default(CUSTOMER)
  bagItems  BagItem[]
  orders    Order[]
  addresses Address[]

  @@map("user")
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]

  @@map("category")
}

model Color {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  hex      String
  variants Variant[]

  @@map("color")
}

model Product {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String
  fabric      String?
  fitNotes    String?       @map("fit_notes")
  gender      Gender
  priceCents  Int           @map("price_cents") // centavos
  imageUrl    String?       @map("image_url")
  hidden      Boolean       @default(false)
  categoryId  String        @map("category_id")
  category    Category      @relation(fields: [categoryId], references: [id])
  variants    Variant[]
  image       ProductImage?
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([categoryId, gender])
  @@map("product")
}

model ProductImage {
  productId   String  @id @map("product_id")
  data        Bytes
  contentType String  @map("content_type")
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_image")
}

model Variant {
  id         String      @id @default(cuid())
  sku        String      @unique
  productId  String      @map("product_id")
  colorId    String      @map("color_id")
  size       Size
  stock      Int         @default(0)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  color      Color       @relation(fields: [colorId], references: [id])
  bagItems   BagItem[]
  orderItems OrderItem[]

  @@unique([productId, colorId, size])
  @@index([size, stock])
  @@map("variant")
}

model BagItem {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  variantId     String   @map("variant_id")
  quantity      Int
  savedForLater Boolean  @default(false) @map("saved_for_later")
  createdAt     DateTime @default(now()) @map("created_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant       Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
  @@map("bag_item")
}

model Address {
  id         String  @id @default(cuid())
  userId     String  @map("user_id")
  fullName   String  @map("full_name")
  phone      String
  street     String
  unit       String?
  city       String
  province   String
  postalCode String  @map("postal_code")
  isDefault  Boolean @default(false) @map("is_default")
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("address")
}

model Order {
  id              String               @id @default(cuid())
  number          Int                  @unique @default(autoincrement())
  userId          String               @map("user_id")
  status          OrderStatus          @default(PROCESSING)
  shippingCents   Int                  @map("shipping_cents")
  shippingMethod  ShippingMethod       @map("shipping_method")
  paymentMethod   PaymentMethod        @map("payment_method")
  cardLast4       String?              @map("card_last4")
  trackingNumber  String?              @map("tracking_number")
  createdAt       DateTime             @default(now()) @map("created_at")
  user            User                 @relation(fields: [userId], references: [id])
  shippingAddress ShippingAddress?
  items           OrderItem[]
  history         OrderStatusHistory[]
  returns         ReturnRequest[]

  @@index([userId, status])
  @@map("order")
}

// Copy of the address at checkout, so editing a saved address doesn't change past orders
model ShippingAddress {
  orderId    String  @id @map("order_id")
  fullName   String  @map("full_name")
  phone      String
  street     String
  unit       String?
  city       String
  province   String
  postalCode String  @map("postal_code")
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("shipping_address")
}

model OrderItem {
  id             String       @id @default(cuid())
  orderId        String       @map("order_id")
  variantId      String       @map("variant_id")
  // Snapshot of the product at checkout
  productName    String       @map("product_name")
  colorName      String       @map("color_name")
  unitPriceCents Int          @map("unit_price_cents")
  quantity       Int
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant        Variant      @relation(fields: [variantId], references: [id])
  returnItems    ReturnItem[]

  @@map("order_item")
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String      @map("order_id")
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now()) @map("created_at")
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_status_history")
}

model ReturnRequest {
  id        String       @id @default(cuid())
  orderId   String       @map("order_id")
  status    ReturnStatus @default(REQUESTED)
  note      String?
  createdAt DateTime     @default(now()) @map("created_at")
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items     ReturnItem[]

  @@map("return_request")
}

model ReturnItem {
  id              String        @id @default(cuid())
  returnRequestId String        @map("return_request_id")
  orderItemId     String        @map("order_item_id")
  quantity        Int
  reason          ReturnReason
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id])

  @@map("return_item")
}

model StoreSetting {
  id                Int @id @default(1)
  lowStockThreshold Int @default(3) @map("low_stock_threshold")

  @@map("store_setting")
}
